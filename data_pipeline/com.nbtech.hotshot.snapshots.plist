<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nbtech.hotshot.snapshots</string>

    <!-- Run the snapshot poller using the backend's Python venv -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/vickylopez/nbtech-clients/hotshot-dashboard/backend/.venv/bin/python</string>
        <string>/Users/vickylopez/nbtech-clients/hotshot-dashboard/data_pipeline/snapshot.py</string>
    </array>

    <!-- Every 3 hours (10800 seconds) -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <!-- Also run once immediately when the schedule is loaded -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs live in ~/Library/Logs: launchd cannot open files under ~/Documents (macOS privacy protection), which made the job exit 78 -->
    <key>StandardOutPath</key>
    <string>/Users/vickylopez/Library/Logs/hotshot_snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vickylopez/Library/Logs/hotshot_snapshot.log</string>
</dict>
</plist>
