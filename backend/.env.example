# Copy this file to .env and fill in your values.
# Never commit .env to git.

# NASA FIRMS API key — get one at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=your_firms_api_key_here

# Path to ELMFIRE output directory (GeoTIFF / GeoJSON files)
ELMFIRE_OUTPUT_DIR=./data/elmfire_outputs

# ELMFIRE binary name/path (if running simulations locally)
ELMFIRE_BINARY=elmfire_single_processor

# Synoptic Data API key (RAWS / WIMS weather stations)
# Register for a free token at: https://synopticdata.com/
SYNOPTIC_API_KEY=your_synoptic_api_key_here

# How long to cache RAWS station data (seconds). Default: 900 (15 min)
WIMS_CACHE_TTL=900

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
