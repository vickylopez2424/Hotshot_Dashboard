[Unit]
Description=Hotshot prediction API (FastAPI + ELMFIRE in Docker)
After=network-online.target docker.service
Requires=docker.service

[Service]
User=hotshot
Group=docker
WorkingDirectory=/opt/hotshot/backend
EnvironmentFile=/etc/hotshot/backend.env
ExecStart=/opt/hotshot/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
